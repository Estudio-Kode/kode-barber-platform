# Segredos do Ziah Cortes lidos pelo systemd (têm prioridade sobre o config.json).
#
# No servidor, copie para /etc/ziah/ziah.env e ajuste os valores:
#   sudo mkdir -p /etc/ziah
#   sudo cp deploy/ziah.env.example /etc/ziah/ziah.env
#   sudo nano /etc/ziah/ziah.env
#   sudo chmod 600 /etc/ziah/ziah.env
#   sudo chown ziah:ziah /etc/ziah/ziah.env
#
# Deixe em branco (ou apague a linha) o que preferir manter no config.json.

# Senha do painel /admin (texto puro; o servidor gera o hash sozinho)
BARBER_ADMIN_PASSWORD=troque-esta-senha-forte

# Usuário do painel (opcional; padrão vem do config.json)
# BARBER_ADMIN_USER=admin

# Token do bot do Telegram (o NOVO, depois de rotacionar no @BotFather)
BARBER_TELEGRAM_TOKEN=

# Um destinatário do Telegram (para vários, use "chat_ids" no config.json)
# BARBER_TELEGRAM_CHAT_ID=
