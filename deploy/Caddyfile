# Caddy — proxy reverso com HTTPS automático para o Ziah Cortes
# Instale em: /etc/caddy/Caddyfile
#
# O Caddy cuida do certificado HTTPS (Let's Encrypt) sozinho e repassa o
# tráfego para o servidor Python, que escuta só em 127.0.0.1:8000.
#
# >>> SEM DOMÍNIO PRÓPRIO? <<<
# Troque a linha de endereço abaixo por  <IP-DO-SERVIDOR>.sslip.io
# O sslip.io resolve qualquer IP: se o IP do servidor é 203.0.113.45,
# o endereço vira  203.0.113.45.sslip.io  — e o Caddy já emite HTTPS grátis
# para ele. Depois, quando tiver um domínio, é só trocar essa linha.
#
# Recarregar após editar:  sudo systemctl reload caddy

203.0.113.45.sslip.io {
	encode gzip
	reverse_proxy 127.0.0.1:8000 {
		# Repassa o IP remoto real para o limite de tentativas do painel.
		header_up X-Real-IP {remote_host}
	}
}

# --- Quando tiver um domínio próprio, use este bloco no lugar do de cima ---
# ziahcortes.com.br, www.ziahcortes.com.br {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:8000
# }
